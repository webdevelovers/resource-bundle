{% macro submit(
    label,
    icon,
    color,
    extraClass,
    method,
    id,
    formID = null,
    extraAttrs
) %}
    {% import _self as buttons %}
    {% import '@WebDeveloversResource/macro/icons.html.twig' as icons %}

    {% set class = extraClass is not empty ?
        ['btn-' ~ color, 'submit-button', extraClass] :
        ['btn-' ~ color, 'submit-button']
    %}
    {% set label = label is empty and label is not null ? null : label|default('wd.action.submit') %}
    {% set icon = icon is empty and icon is not null ? null : icon|default('tabler:plus') %}
    {% set classes = ['btn']|merge(class) %}
    {% set method = method|default('post') %}

    <button
            class="{{ classes|join(' ') }}"
            type="submit"
            {% if method is not same as 'post' %} formmethod="{{ method }}"{% endif %}
            {% if formID is not empty %} form="{{ formID }}"{% endif %}
            {% for key, value in extraAttrs %} {{ key }}="{{ value }}"{% endfor %}
    >
        {% if icon is not empty %}
            {{ icons.base(icon, 'me-1') }}
        {% endif %}
        {% if label %}{{ label|trans|capitalize }}{% endif %}
    </button>
{% endmacro %}

{% macro delete(url, message, labeled = true, resourceId = null, extra_class = '', confirm = false) %}
    {% import '@WebDeveloversResource/macro/icons.html.twig' as icons %}

    <form action="{{ url }}" method="post" class="btn-group">
        <input type="hidden" name="_method" value="DELETE">
        <button class="btn btn-danger d-flex align-items-center {{ extra_class }} delete-button rounded-end" type="submit"
                data-requires-confirmation
                data-id="{{ resourceId }}"
                {% if confirm %}
                    onclick="return confirm('{{ (confirm is same as(true) ? 'wd.ui.confirm_delete' : confirm)|trans }}')"
                {% endif %}
        >
            {{ icons.delete('me-1') }} <span>{{ ((message is empty and labeled) ? 'wd.action.delete' : message)|trans|capitalize }}</span>
        </button>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token(resourceId) }}" />
    </form>
{% endmacro %}

{% macro bulkDelete(url, message, labeled = true, size_class = '') %}
    {% import '@WebDeveloversResource/macro/icons.html.twig' as icons %}

    <form action="{{ url }}" method="post">
        <input type="hidden" name="_method" value="DELETE">
        <button class="btn btn-danger {{ size_class }} bulk-delete-action" type="submit" data-bulk-action-requires-confirmation disabled>
            {{ icons.delete() }} {{ ((message is empty and labeled) ? 'wd.action.delete' : message)|trans }}
        </button>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('bulk_delete') }}" />
    </form>
{% endmacro %}

{% macro filter(message, size_class = '') %}
    {% import '@WebDeveloversResource/macro/icons.html.twig' as icons %}

    <button class="btn btn-primary {{ size_class }}" type="submit">
        {{ icons.filter() }} {{ (message is empty ? 'wd.ui.filter' : message)|trans }}
    </button>
{% endmacro %}

{% macro resetFilters(url, message, size_class = '') %}
    {% import '@WebDeveloversResource/macro/icons.html.twig' as icons %}

    <a class="btn btn-primary {{ size_class }}" href="{{ url }}">
        {{ icons.x() }} {{ (message is empty ? 'wd.ui.clear_filters' : message)|trans }}
    </a>
{% endmacro %}
