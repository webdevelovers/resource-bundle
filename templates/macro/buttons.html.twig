{% macro default(url, label, icon, class = [], id = null, extraAttrs = []) %}
    {% import '@WebDeveloversResource/macro/icons.html.twig' as icons %}

    <a role="button"
        {% set classes = ['btn']|merge(class) %}
        class="{{ classes|join(' ') }}"
        {% if id is not null %} id="{{ id }}"{% endif %}
        href="{% if url is not empty %}{{ url }}{% else %}#{% endif %}"
        {% for key, value in extraAttrs %} {{ key }}="{{ value }}"{% endfor %}>

        {% if icon is not empty %}
            <twig:ux:icon name="{{ icon }}" class="fs-xl me-1" />
        {% endif %}
        {% if label is not empty %}
            {{ label|trans|capitalize }}
        {% endif %}
    </a>
{% endmacro %}

{% macro create(
    url,
    label,
    icon,
    color,
    extraClass,
    id,
    extraAttrs
) %}
    {% import _self as buttons %}

    {% set class = extraClass is not empty ?
        ['btn-' ~ color, 'text-nowrap create-button', extraClass] :
        ['btn-' ~ color, 'text-nowrap create-button']
    %}
    {% set label = label is empty and label is not null ? null : label|default('wd.action.create') %}
    {% set icon = icon is empty and icon is not null ? null : icon|default('tabler:plus') %}

    {{ buttons.default(url, label, icon, class, id, extraAttrs) }}
{% endmacro %}

