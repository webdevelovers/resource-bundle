<div{{ attributes }} id="followers-component">
    {% set followers = this.followers %}
    {% set referenceObject =  {
        'resourceID' : this.resourceID,
        'resourceName' : this.resourceName,
        'resourceType' : this.resourceType
    } %}

    <div class="following-status me-2">
        <button
                class="btn px-2 border-0 text-white rounded-0 toolbox-action
                        {% if this.isFollowing %}btn-danger{% else %}btn-secondary{% endif%}"
                data-action="live#action"
                data-live-action-param="followToggle"
        >
            {% if this.isFollowing %}Non seguire{% else %}Segui{% endif %}
        </button>
    </div>

    {% if followers|length > 0 %}
        <div class="dropdown">
            <a class="dropdown-toggle text-black text-decoration-none" data-bs-toggle="dropdown" href="#" aria-expanded="false" data-bs-offset="0,10">
                {{ ux_icon('tabler:user-circle') }} <span class="label label-success">{{ followers|length }}</span>
            </a>
            <ul class="dropdown-menu rounded-0" style="min-width:250px;">
                {% if followers is not empty %}
                    <li><a class="dropdown-item disabled" aria-disabled="true">Followers</a></li>
                {% endif %}
                {% set currentUser = app.user %}
                {% for follower in followers %}
                    <li class="dropdown-item d-flex">
                        {{ ux_icon('tabler:user-filled', {class: 'me-2'}) }} {{ follower.user }}
                        {% if
                            (currentUser is not null and follower.user.id == currentUser.id)
                        %}
                            <button
                                    class="btn btn-sm btn-outline-danger rounded-2 p-0 m-0 ms-auto"
                                    title="Rimuovi follower"
                                    data-action="live#action"
                                    data-live-action-param="removeFollower"
                                    data-live-id-param="{{ follower.user.id.toRfc4122 }}"
                            >
                                {{ ux_icon('tabler:x') }}
                            </button>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <div class="ms-2">{{ ux_icon('tabler:user-circle') }}</div>
    {% endif %}
</div>
